{
    "name": "tools",
    "id": "tools",
    "version": "1.5.3",
    "description": "A minimal dev container feature that bundles terminal-based development tools, 1Password CLI, C/C++ build tools, Tailscale access, and an optional OpenSSH server.",
    "entrypoint": "/usr/local/bin/tailscale-entrypoint.sh",
    "capAdd": [
        "NET_ADMIN",
        "NET_RAW",
        "MKNOD"
    ],
    "mounts": [
        {
            "source": "tools-tailscale-state",
            "target": "/var/lib/tailscale",
            "type": "volume"
        },
        {
            "source": "tools-ssh-host-keys",
            "target": "/var/lib/ssh-host-keys",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "TS_STATE_DIR": "/var/lib/tailscale",
        "TS_ENABLE_SSH": "true",
        "TS_TAG": "tag:dev-container",
        "SSHD_ENABLE": "true",
        "SSHD_USER": "root"
    },
    "options": {
        "installLazygit": {
            "type": "boolean",
            "description": "Install lazygit terminal UI for Git",
            "default": true
        },
        "installNvim": {
            "type": "boolean",
            "description": "Install neovim and supporting tools (ripgrep, fd, fzf)",
            "default": true
        },
        "lazygitVersion": {
            "type": "string",
            "description": "lazygit version to install (e.g., '0.40.2', 'latest')",
            "default": "latest"
        },
        "nvimVersion": {
            "type": "string",
            "description": "neovim version to install (e.g., '0.9.5', 'latest')",
            "default": "latest"
        },
        "installClaudeCode": {
            "type": "boolean",
            "description": "Install Claude Code CLI (AI coding assistant)",
            "default": true
        },
        "installCodex": {
            "type": "boolean",
            "description": "Install OpenAI Codex CLI",
            "default": true
        },
        "installGh": {
            "type": "boolean",
            "description": "Install GitHub CLI (gh)",
            "default": true
        },
        "installOp": {
            "type": "boolean",
            "description": "Install 1Password CLI (op)",
            "default": true
        },
        "installFdsx": {
            "type": "boolean",
            "description": "Install fdsx (fast data serialization tool)",
            "default": true
        },
        "installRtk": {
            "type": "boolean",
            "description": "Install rtk (Rust Token Killer - token-optimized CLI proxy)",
            "default": true
        },
        "installPi": {
            "type": "boolean",
            "description": "Install pi coding agent",
            "default": true
        },
        "installJust": {
            "type": "boolean",
            "description": "Install just command runner",
            "default": true
        },
        "installDirenv": {
            "type": "boolean",
            "description": "Install direnv environment switcher",
            "default": true
        },
        "installTailscale": {
            "type": "boolean",
            "description": "Install Tailscale and configure the tools entrypoint for Tailscale SSH",
            "default": false
        },
        "installSshd": {
            "type": "boolean",
            "description": "Install and start OpenSSH server for normal SSH access",
            "default": true
        },
        "installBuildTools": {
            "type": "boolean",
            "description": "Install python3, make, and a C++ compiler when missing",
            "default": true
        }
    }
}
